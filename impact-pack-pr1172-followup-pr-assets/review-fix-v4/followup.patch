+    torch.testing.assert_close(mask, torch.full((1, 64, 64), 127 / 255))
+    assert item == {"filename": filename, "subfolder": subfolder, "type": "input"}
+    assert (input_dir / subfolder / filename).read_bytes() == target.read_bytes()
