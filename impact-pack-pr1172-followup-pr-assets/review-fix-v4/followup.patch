+    refreshed_rgb = None
+    for _ in range(2):
+        # Reuse must keep the refreshed pixels, not reload the original red image.
+        result = node.doit(image=reference, unique_id="shared", restore_mask="if_same_size", **inputs)
+        output, mask = result["result"]
