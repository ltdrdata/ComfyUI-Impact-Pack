+        relative = "clipspace/saved.png"
+        filename, subfolder = "saved.png", "clipspace"
+    else:
+        subfolder = "clipspace" if kind == "legacy-fallback" else ""
+        (input_dir / subfolder).mkdir(exist_ok=True)
