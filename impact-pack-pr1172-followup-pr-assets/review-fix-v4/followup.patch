+    assert.equal(widget.value, "second.png [input]");
+    node.onExecuted({ source_image: ["$41-second"], images: [{ filename: "second-output.png", subfolder: "", type: "temp" }] });
+    assert.equal(widget.value, "second-output.png [temp]");
+});
