+        right = ui.app.evaluate("""(app, id) => {
+            const node = app.graph.getNodeById(id);
+            const mode = node.widgets.find(w => w.name === 'mode');
+            return app.canvasPosToClientPos([node.pos[0] + node.size[0] - 25,
+                node.pos[1] + (mode.last_y ?? mode.y) + 10]);
+        }""", host)
