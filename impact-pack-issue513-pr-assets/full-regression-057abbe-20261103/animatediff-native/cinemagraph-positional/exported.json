      "properties": {
        "text": ""
      },
      "widgets_values": [
        "Then, in the \"AnimateDiff Loader,\" I chose the \"v14\" model to give more dynamic motion.\n"
      ],
      "widgets_values_named": {
        "text": "Then, in the \"AnimateDiff Loader,\" I chose the \"v14\" model to give more dynamic motion.\n"
