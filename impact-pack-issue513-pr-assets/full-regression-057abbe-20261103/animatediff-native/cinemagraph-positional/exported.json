      "title": "4. Create Frames",
      "properties": {
        "text": ""
      },
      "widgets_values": [
        "To create a still image with 16 frames for AnimateDiff, use the \"Change Image Batch Size\" node from the Inspire Pack. \n\nAlthough using the sliding context technique of AnimateDiff could go beyond 16 frames, here we will stick to the simplest form of 16 frames.\n"
      ],
      "widgets_values_named": {
        "text": "To create a still image with 16 frames for AnimateDiff, use the \"Change Image Batch Size\" node from the Inspire Pack. \n\nAlthough using the sliding context technique of AnimateDiff could go beyond 16 frames, here we will stick to the simplest form of 16 frames.\n"
      },
      "color": "#222",
      "bgcolor": "#000"
